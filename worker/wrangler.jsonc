{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resumelens-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Static Next.js export (frontend/out). /api/* goes to the Worker, everything else is served as assets.
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Workers AI: free 10,000 neurons/day, no API key needed.
  "ai": { "binding": "AI" },
  "vars": {
    // auto = try every configured provider in order: gemini → groq → openrouter → workers-ai
    "AI_PROVIDER": "auto"
  }
  // API keys are secrets, never vars:
  //   npx wrangler secret put GEMINI_API_KEY
  //   npx wrangler secret put GROQ_API_KEY
  //   npx wrangler secret put OPENROUTER_API_KEY
}
